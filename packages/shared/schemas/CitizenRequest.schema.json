{
  "$defs": {
    "Lang": {
      "description": "UI / answer language.",
      "enum": [
        "si",
        "ta",
        "en"
      ],
      "title": "Lang",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "A user-facing string in all three official languages.",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "si": {
          "minLength": 1,
          "title": "Si",
          "type": "string"
        },
        "ta": {
          "minLength": 1,
          "title": "Ta",
          "type": "string"
        }
      },
      "required": [
        "en",
        "si",
        "ta"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "RequestStatus": {
      "enum": [
        "exploring",
        "checklist",
        "form_ready",
        "visited"
      ],
      "title": "RequestStatus",
      "type": "string"
    },
    "VisitOutcome": {
      "enum": [
        "unknown",
        "first_visit_success",
        "needed_return"
      ],
      "title": "VisitOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A row in 'My requests' (stored on the device).",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "procedureId": {
      "title": "Procedureid",
      "type": "string"
    },
    "language": {
      "$ref": "#/$defs/Lang"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "title": "Updatedat",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RequestStatus",
      "default": "exploring"
    },
    "checklist": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Checklist",
      "type": "object"
    },
    "formId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Formid"
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purpose"
    },
    "filledValues": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Filledvalues",
      "type": "object"
    },
    "formFilledPct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Formfilledpct"
    },
    "manualSteps": {
      "description": "e.g. 'Sign field 06 in front of the GN'",
      "items": {
        "$ref": "#/$defs/LocalizedText"
      },
      "title": "Manualsteps",
      "type": "array"
    },
    "visitPackCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visitpackcode"
    },
    "outcome": {
      "$ref": "#/$defs/VisitOutcome",
      "default": "unknown"
    }
  },
  "required": [
    "id",
    "procedureId",
    "language",
    "createdAt",
    "updatedAt"
  ],
  "title": "CitizenRequest",
  "type": "object"
}
