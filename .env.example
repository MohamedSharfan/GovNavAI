# ---------------------------------------------------------------------------
# GovNavAI environment. Copy to `.env` (never commit `.env`).
# With no GEMINI_API_KEY the agent service runs in OFFLINE mode: the same ADK
# agent tree, driven by a deterministic local model. Good for dev and CI.
# ---------------------------------------------------------------------------

# --- Agent service (services/agents) ---------------------------------------
# Google AI Studio key (https://aistudio.google.com/apikey). Leave empty for offline mode.
GEMINI_API_KEY=
# "auto" = gemini if a key is set, otherwise offline. Or force: "gemini" | "offline".
GOVNAV_LLM_MODE=auto
# Knowledge base backend: "local" (data/*.json + in-memory index) | "firestore"
GOVNAV_KB_BACKEND=local
# Retrieval: below this fused confidence the assistant declines honestly.
GOVNAV_RETRIEVAL_THRESHOLD=0.45
# Comma-separated origins allowed to call the API.
GOVNAV_CORS_ORIGINS=http://localhost:3000
# Google Cloud (Firestore / Storage / Cloud Run), used when GOVNAV_KB_BACKEND=firestore
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
# Officer console: comma-separated Google account emails allowed to approve records.
GOVNAV_OFFICER_EMAILS=

# --- Web app (apps/web) ----------------------------------------------------
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8080
# Maps JavaScript API key (restricted by HTTP referrer). Optional: a static fallback map is shown without it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Firebase web config (public by design; protect with App Check + security rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
