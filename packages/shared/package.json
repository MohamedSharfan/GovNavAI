{
  "name": "@govnav/shared",
  "version": "0.1.0",
  "private": true,
  "description": "GovNavAI shared contracts: JSON Schemas exported from the Pydantic models and the TypeScript types generated from them.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "gen": "node ./scripts/gen-types.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3"
  }
}
