{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "Normalised bounding box, origin top-left, all values 0..1.",
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "w": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "W",
          "type": "number"
        },
        "h": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "BBox",
      "type": "object"
    },
    "FieldScript": {
      "enum": [
        "as_profile",
        "si",
        "ta",
        "en",
        "latin_caps"
      ],
      "title": "FieldScript",
      "type": "string"
    },
    "FieldType": {
      "enum": [
        "text",
        "multiline",
        "date",
        "nic",
        "phone",
        "checkbox",
        "signature"
      ],
      "title": "FieldType",
      "type": "string"
    },
    "FillMode": {
      "enum": [
        "auto",
        "confirm",
        "input",
        "manual",
        "officer"
      ],
      "title": "FillMode",
      "type": "string"
    },
    "FormField": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "label": {
          "$ref": "#/$defs/LocalizedText"
        },
        "page": {
          "minimum": 0,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "type": {
          "$ref": "#/$defs/FieldType",
          "default": "text"
        },
        "profileKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fillMode": {
          "$ref": "#/$defs/FillMode"
        },
        "script": {
          "$ref": "#/$defs/FieldScript",
          "default": "as_profile"
        },
        "maxChars": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxchars"
        },
        "fontSize": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fontsize"
        },
        "optional": {
          "default": false,
          "description": "Only some applicants fill it (e.g. land income).",
          "title": "Optional",
          "type": "boolean"
        },
        "hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "label",
        "page",
        "bbox",
        "fillMode"
      ],
      "title": "FormField",
      "type": "object"
    },
    "Lang": {
      "description": "UI / answer language.",
      "enum": [
        "si",
        "ta",
        "en"
      ],
      "title": "Lang",
      "type": "string"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "A user-facing string in all three official languages.",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "si": {
          "minLength": 1,
          "title": "Si",
          "type": "string"
        },
        "ta": {
          "minLength": 1,
          "title": "Ta",
          "type": "string"
        }
      },
      "required": [
        "en",
        "si",
        "ta"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "PageSize": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "description": "PDF points",
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "description": "PDF points",
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "PageSize",
      "type": "object"
    },
    "ProfileKey": {
      "description": "Keys a form field may map to. Kept in sync with the web Profile type.",
      "enum": [
        "fullNameEn",
        "fullNameSi",
        "fullNameTa",
        "fullName",
        "nameWithInitials",
        "nic",
        "dateOfBirth",
        "gender",
        "address",
        "gnDivisionName",
        "gnDivisionCode",
        "dsDivision",
        "district",
        "phone",
        "occupation",
        "civilStatus",
        "purpose",
        "today"
      ],
      "title": "ProfileKey",
      "type": "string"
    },
    "RecordStatus": {
      "enum": [
        "draft",
        "approved"
      ],
      "title": "RecordStatus",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "circular",
        "gazette",
        "act",
        "website",
        "form",
        "office_notice",
        "field_visit"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "An authorising or informing source for one or more facts.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "retrievedAt": {
          "format": "date",
          "title": "Retrievedat",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "retrievedAt"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "description": "Human-in-the-loop provenance kept on every record.",
      "properties": {
        "status": {
          "$ref": "#/$defs/RecordStatus"
        },
        "sourceRef": {
          "description": "Primary SourceRef id",
          "title": "Sourceref",
          "type": "string"
        },
        "verifiedBy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verifiedby"
        },
        "verifiedAt": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verifiedat"
        },
        "demoData": {
          "default": false,
          "description": "True when one or more facts could not be confirmed from an official source.",
          "title": "Demodata",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "sourceRef"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "name": {
      "$ref": "#/$defs/LocalizedText"
    },
    "procedureIds": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Procedureids",
      "type": "array"
    },
    "pdfPath": {
      "title": "Pdfpath",
      "type": "string"
    },
    "pageCount": {
      "minimum": 1,
      "title": "Pagecount",
      "type": "integer"
    },
    "pageSizes": {
      "items": {
        "$ref": "#/$defs/PageSize"
      },
      "minItems": 1,
      "title": "Pagesizes",
      "type": "array"
    },
    "verifiedYear": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verifiedyear"
    },
    "language": {
      "items": {
        "$ref": "#/$defs/Lang"
      },
      "title": "Language",
      "type": "array"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FormField"
      },
      "title": "Fields",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    }
  },
  "required": [
    "id",
    "code",
    "name",
    "procedureIds",
    "pdfPath",
    "pageCount",
    "pageSizes",
    "fields",
    "sources",
    "verification"
  ],
  "title": "FormMap",
  "type": "object"
}
