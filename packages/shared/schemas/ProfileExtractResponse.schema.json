          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "source": {
          "default": "ai",
          "enum": [
            "ai",
            "derived"
          ],
          "title": "Source",
          "type": "string"
        },
        "warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
