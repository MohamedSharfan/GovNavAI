      },
      "title": "Fields",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "imageRetained": {
      "const": false,
      "default": false,
      "title": "Imageretained",
      "type": "boolean"
    }
  },
  "required": [
